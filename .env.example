PORT=8000

# Set to `production` to enforce the startup config checks: a weak/default
# SEED_USER_PASSWORD, a known default API key, or SEED_DEMO_USERS=true then
# become fatal instead of a warning. Leave unset for local dev.
APP_ENV=

# Comma-separated "service" keys (sent as `x-api-key`) for internal/CI callers.
# Per-user keys also work; external partners use OAuth2 clients (see below).
# Leave empty to disable service keys entirely.
API_KEYS=change-me-in-production

# Max upload size in MB (applies to PDF ingestion). Keep in sync with
# `client_max_body_size` in infrastructure/nginx/nginx.conf.
MAX_FILE_SIZE_MB=100

# Postgres for users / sessions / API clients / tokens / job history / RAG
# document+chunk metadata. Unset => in-memory (fine for local dev; everything
# resets on restart). Both compose files provide a bundled Postgres and point
# the API at it, so leave this blank to use that. Set it to override with an
# external instance.
DATABASE_URL=

# Credentials for the *bundled* Postgres (compose.dev.yml / compose.prod.yml).
# Ignored when DATABASE_URL points at an external database.
# CHANGE POSTGRES_PASSWORD for any real deployment.
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag

# Redis for the per-IP rate limiters. Set => shared across API replicas;
# unset => process-local (fine for a single node). Both compose files ship one
# and point the API at it. If Redis is unreachable the limiter fails open.
REDIS_URL=

# CORS: `*` for local dev. In production set the explicit public origin(s),
# comma-separated, e.g. https://rag.example.com
CORS_ALLOWED_ORIGINS=*

# Trust X-Forwarded-For / X-Real-IP (true when behind the bundled nginx proxy).
# Set to false if the app is exposed directly to clients.
TRUST_PROXY=true

# Per-IP throttle for /api/v1/auth/* and /api/ext/auth/*  ("<attempts>/<seconds>")
AUTH_RATE_LIMIT=10/60

# Per-IP throttle for every other /api route ("<n>/<seconds>", "off" to disable).
# Redundant behind the bundled nginx, but protects a directly-exposed deployment.
API_RATE_LIMIT=120/60

# Serve the OpenAPI spec (/api/openapi.json) + Scalar (/api/docs) + Swagger UI (/api/swagger).
# Unset  -> on when APP_ENV is not production, off when it is.
# true/false -> force it either way (explicit true in production is allowed but warned).
ENABLE_API_DOCS=

# ── RAG (POST/GET /api/rag/*) ────────────────────────────────────────────────
# Ingestion (PDF → text → chunks → embeddings → Qdrant) and querying. Empty
# LLM_API_KEY leaves /api/rag/* disabled (503) — nothing else here matters
# until it's set. Once set, Qdrant must be reachable or the API fails to
# start (both compose files bundle a `qdrant` service by default).
# Drives both the embeddings and the answer-generation calls — one NVIDIA NIM
# (or other OpenAI-compatible host) account behind both.
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDINGS_MODEL=nvidia/nemotron-3-embed-1b
CHAT_MODEL=meta/llama-3.2-11b-vision-instruct
# Ceiling applied to the answer call's max_tokens.
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECS=60

# Qdrant gRPC endpoint. Defaults to the bundled `qdrant` service — leave
# unset unless pointing at an external/managed instance.
QDRANT_URL=
QDRANT_COLLECTION=documents

# Chunking window for ingested document text, in characters.
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=150
# Default top_k for /api/rag/query when a caller doesn't set one.
RAG_TOP_K=8

# POST /api/rag/sync/erp reads products/orders from this database and
# ingests them into the RAG index — a system this API doesn't own (unlike
# DATABASE_URL, its own persistence), simulating a real ERP/CRM integration.
# Empty ⇒ the sync route answers 503. compose.dev.yml bundles a seeded
# `erp-db` service with fictitious data by default.
ERP_DATABASE_URL=

# ── Admin UI auth ───────────────────────────────────────────────────────────
# Public app name served at GET /api/v1/config.
APP_NAME=Ragers
# Add `Secure` to the session cookie + emit HSTS — enable when serving over HTTPS.
SESSION_COOKIE_SECURE=false
# Admin account seeded into the in-memory user store on startup.
SEED_USER_EMAIL=admin@rag.test
SEED_USER_PASSWORD=admin1234
SEED_USER_NAME=Admin
# API key owned by the seeded user (defaults to the first API_KEYS entry).
SEED_USER_API_KEY=dev-key
# Seed the demo `user` accounts (maria@ / carlos@, password "demo1234").
# Dev convenience only — MUST be false in production.
SEED_DEMO_USERS=true

# ── External API clients (OAuth2 client-credentials) ────────────────────────
# Defaults applied to clients that don't set their own. Empty = unlimited.
# Rate limit format: "<requests>/<seconds>", e.g. 60/60
EXT_DEFAULT_RATE_LIMIT=
EXT_DEFAULT_MONTHLY_PAGE_QUOTA=
# Same, but for tokens spent on the LLM-backed endpoints (POST
# /api/rag/documents, POST /api/rag/query).
EXT_DEFAULT_AI_TOKEN_QUOTA=

RUST_LOG=rag_api=info,tower_http=info
