# ─────────────────────────────────────────────────────────────────────────────
# Configuración del frontend (Vite).
#
#   corepack enable     # usa la pnpm de "packageManager" (pnpm@12.x)
#   cp .env.example .env
#   pnpm install
#   pnpm dev            # servidor de desarrollo
#   pnpm build          # bundle de producción -> dist/
#
# Vite solo expone al navegador las variables con prefijo VITE_ y las "hornea"
# en el bundle (dev: al arrancar; prod: en `pnpm build`) — un cambio requiere
# reiniciar/rebuild. Se leen desde `src/config/env.ts` (import.meta.env.*).
# Con Docker las inyecta compose; este fichero es para `pnpm dev/build` a mano.
# ─────────────────────────────────────────────────────────────────────────────

# Nombre visible de la app. Solo FALLBACK: en runtime lo pisa el backend vía
# GET /api/v1/config (APP_NAME del backend). Ver src/config/env.ts.
VITE_APP_NAME=Ragers

# Proxy del dev-server hacia el backend (vite.config.ts). En Docker: http://backend:8000
VITE_BACKEND_URL=http://localhost:8000

# Base de la API que usa el cliente. Vacío = mismo origen (a través del proxy/nginx).
VITE_PUBLIC_API_URL=

# URL pública del propio frontend y base de assets. Vacío = relativo.
VITE_APP_URL=
VITE_ASSET_URL=

# Prefijo de las claves en localStorage.
VITE_STORAGE_PREFIX=__ans_

# Roles que saltan toda comprobación de permisos (coma-separada).
VITE_FULL_ACCESS_ROLES=admin
